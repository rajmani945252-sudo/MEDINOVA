PORT=5000
HOST=0.0.0.0

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=medinova

# App secrets
JWT_SECRET=replace-with-a-long-random-secret

# Startup and connection tuning
DB_SSL=false
DB_RETRY_DELAY_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173
VERCEL_FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-frontend.vercel.app

# Optional admin bootstrap for fresh deployments
# ADMIN_EMAIL=admin@medinova.local
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Medinova Admin
# ADMIN_PHONE=

# Railway / hosted MySQL alternatives
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=
# DATABASE_URL=
